# 이 파일을 .env 로 복사한 뒤 값을 바꿔 주세요 (.env 는 git 에 올라가지 않습니다)

# 관리자 모드 비밀번호 (필수, 1234 사용 불가)
SURVEY_ADMIN_PIN=여기에_비밀번호

# Cloudflare Tunnel 토큰 (필수) — Cloudflare 대시보드에서 터널 "pgd" 생성 시 표시되는 토큰
# 'cloudflared ... --token eyJ...' 명령에서 eyJ 로 시작하는 부분만 붙여넣습니다
CLOUDFLARE_TUNNEL_TOKEN=

# 서버 내부 포트 (보통 바꿀 필요 없음)
PORT=8080
